{
  "name": "x-stream-pro",
  "version": "1.0.0",
  "description": "Premium 8K Video Aggregator with Pro FFmpeg Backend",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.xstream.pro",
    "productName": "X-Stream Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/*"
    ],
    "asar": true
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "http-proxy": "^1.18.1",
    "puppeteer": "^24.42.0",
    "socket.io": "^4.8.3",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.0"
  }
}
